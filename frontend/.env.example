# ==============================
# Kryzen frontend — Environment Template
# Local dev needs nothing (Vite proxy + same-host WS just work).
# Vercel: set these as Environment Variables (Production + Preview) to link
# the Vercel web app to the Render backend. Redeploy after changing them
# (Vite bakes VITE_* into the bundle at build time).
# ==============================

# Render backend origin (REST). Same value the Android shell uses.
VITE_API_URL=https://kb-chat-1.onrender.com
# Render backend WS origin. Same host, wss scheme.
VITE_WS_URL=wss://kb-chat-1.onrender.com

# Google OAuth client ID (public by design — ships in the bundle).
VITE_GOOGLE_CLIENT_ID=

# Firebase web config (public by design — ships in the bundle).
# Must match backend FIREBASE_* so push + Google native auth agree.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional 3D landing assets (unset = skipped, page works without them).
VITE_SPLINE_SCENE_URL=
VITE_RIVE_SRC=
