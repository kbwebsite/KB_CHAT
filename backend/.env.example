DATABASE_URL=sqlite:///./kbchat.db
# For postgres use: postgresql://user:password@localhost:5432/kbchat
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# AI Agent Configuration
# Option 1: OpenAI (requires API key)
# AI_API_KEY=sk-your-openai-key-here
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Option 2: Ollama (local, free - run: ollama pull llama3.1)
# AI_API_KEY=ollama
# AI_PROVIDER=openai
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1

# Option 3: LM Studio (local, free)
# AI_API_KEY=lm-studio
# AI_PROVIDER=openai
# AI_BASE_URL=http://localhost:1234/v1
# AI_MODEL=local-model

# Option 4: OpenRouter (cheap, many models)
# AI_API_KEY=sk-or-your-key
# AI_PROVIDER=openai
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openrouter/auto

# Default: mock provider (no API key needed, limited functionality)
AI_API_KEY=
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Embedding model (local, no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=./vector_store
CODE_INDEX_ENABLED=true
AGENT_MAX_ITERATIONS=10
AGENT_MAX_CONTEXT_TOKENS=8000
