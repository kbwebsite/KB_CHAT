rules_version = '2';

// KB-CHAT realtime backend — project kbwebsite-s.
// Mirrors the existing REST data model so clients can migrate collection by
// collection. Server timestamps (request.time) are the source of truth.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isConvMember(cid) {
      return signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(cid)
        ).data.memberIds;
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---------- conversations ----------
    match /conversations/{cid} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds;
      allow delete: if false;

      // ---------- messages ----------
      match /messages/{mid} {
        allow read: if isConvMember(cid);
        allow create: if isConvMember(cid)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 12000;
        allow update: if isConvMember(cid)
          && resource.data.senderId == request.auth.uid;
        // soft-delete only: clients flip isDeleted, rows are never removed
        allow delete: if false;
      }

      // ---------- webrtc signaling (ephemeral, client-cleaned) ----------
      match /signals/{sid} {
        allow read, write: if isConvMember(cid);
      }
    }

    // ---------- statuses (stories) ----------
    match /statuses/{sid} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || request.auth.uid in resource.data.get('allowedUids', [])
      );
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      match /viewers/{uid} {
        // the status owner sees who watched; anyone signed-in may mark own view
        allow read: if signedIn()
          && get(/databases/$(database)/documents/statuses/$(sid)).data.userId == request.auth.uid;
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if false;
      }
    }

    // ---------- polls ----------
    match /polls/{pid} {
      allow read: if signedIn() && request.auth.uid in get(
        /databases/$(database)/documents/conversations/$(resource.data.conversationId)
      ).data.memberIds;
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.creatorId == request.auth.uid;

      match /votes/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn()
          && (request.auth.uid == uid || get(
            /databases/$(database)/documents/polls/$(pid)
          ).data.creatorId == request.auth.uid);
      }
    }

    // ---------- events ----------
    match /events/{eid} {
      allow read: if signedIn() && request.auth.uid in get(
        /databases/$(database)/documents/conversations/$(resource.data.conversationId)
      ).data.memberIds;
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.creatorId == request.auth.uid;

      match /responses/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if false;
      }
    }

    // ---------- calls (history + ringing state) ----------
    match /calls/{callId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.callerId
        || request.auth.uid == resource.data.calleeId
      );
      allow create: if signedIn()
        && request.resource.data.callerId == request.auth.uid;
      allow update: if signedIn() && (
        request.auth.uid == resource.data.callerId
        || request.auth.uid == resource.data.calleeId
      );
      allow delete: if false;
    }

    // ---------- sticker packs (read-only catalog, seeded by admins) ----------
    match /stickerPacks/{packId} {
      allow read: if signedIn();
      allow write: if false;

      match /stickers/{stickerId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // ---------- device push tokens (owner only) ----------
    match /deviceTokens/{docId} {
      allow read, write: if signedIn()
        && request.auth.uid == resource.data.userId;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
