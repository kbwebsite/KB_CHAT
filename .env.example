# ==============================
# KB Chat — Environment Template
# Copy to .env (local) or set in Render Dashboard → Environment
# NEVER commit .env with secrets
# ==============================

# --- Core ---
APP_ENV=development
# strong random: openssl rand -hex 32  (MIN 32 chars)
JWT_SECRET=dev-secret-change-in-production-please-use-strong-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Local: sqlite:///./kbchat.db  (default if empty)
# Production (Supabase/Postgres): postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres?sslmode=require
# For Supabase pooled:  postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=sqlite:///./kbchat.db

# --- CORS ---
# comma-separated, no spaces needed
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://kb-chat-jqdk.onrender.com

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# --- AI (optional) ---
# mock (default) | openai | gemini | anthropic
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# --- OAuth ---
GOOGLE_CLIENT_ID=

# --- WebRTC / TURN (optional) ---
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# --- Server (Render injects PORT) ---
HOST=127.0.0.1
PORT=8000
